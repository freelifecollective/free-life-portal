# Supabase project (Settings > API). Without these two the app runs in preview mode locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, used in the emailed sign-in link (optional; falls back to the request host).
NEXT_PUBLIC_SITE_URL=

# Profile picture cutout: "auto" (model, then built-in fallback), "model" or "fallback".
NEXT_PUBLIC_CUTOUT_ENGINE=auto
# Self-host the model files (recommended in production), e.g. https://your-site.com/models/background-removal/
NEXT_PUBLIC_CUTOUT_MODEL_URL=

# Preview mode is blocked in production unless this is set to 1 (do not set it on the real site).
# ALLOW_DEMO_MODE=1
